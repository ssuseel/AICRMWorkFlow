# Copy to .streamlit/secrets.toml for local Streamlit overrides.
# Never commit secrets.toml.

DATABASE_URL = "sqlite:///./aicrm.db"
APP_ENV = "development"
LOG_LEVEL = "INFO"
DEFAULT_TENANT_ID = "00000000-0000-0000-0000-000000000001"
AI_PROVIDER = "mock"
EMAIL_PROVIDER = "mock"
CRM_PROVIDER = "mock"
GMAIL_CLIENT_ID = ""
GMAIL_CLIENT_SECRET = ""
GMAIL_REFRESH_TOKEN = ""
GMAIL_SENDER = ""
SALESFORCE_CLIENT_ID = ""
SALESFORCE_CLIENT_SECRET = ""
SALESFORCE_LOGIN_URL = "https://login.salesforce.com"
SALESFORCE_API_VERSION = "v60.0"
